local pujqtoav = fk.CreateSkill {
  name = "pujqtoav",
}

Fk:loadTranslationTable{
  ["pujqtoav"] = "飛刀",
  [":pujqtoav"] = "伱可使用殺旹伱可預將1裝僃牌牌轉化爲殺使用發動.飛刀殺无視距離且致傷旹,伱可選擇1花色發動.受傷角色不可使用打出該花牌(含子牌)至其下轉終",

  ["@pujqtoav"] = "飛刀",
  ["#pujqtoav-choose"] = "飛刀 選擇花色 %src不能使用打出之",
}

pujqtoav:addEffect("viewas", {
  anim_type = "offensive",
  pattern = "ssaet",
  prompt = "#pujqtoav",
  mute_card = true,
  handly_pile = true,
  card_filter = function(self, player, to_select, selected)
    return #selected == 0 and Fk:getCardById(to_select).type==Card.TypeEquip
  end,
  view_as = function(self, player, cards)
    if #cards ~= 1 then return end
    local c = Fk:cloneCard("ssaet")
    c.skillName = pujqtoav.name
    c:addSubcard(cards[1])
    return c
  end,
  enabled_at_play = Util.TrueFunc,
  enabled_at_response = function(self, player, response)
    return  not response
  end,
})


pujqtoav:addEffect("targetmod", {
  bypass_distances = function(self, player, skill, card)
    return card and table.contains(card.skillNames, pujqtoav.name)
  end,
})


pujqtoav:addEffect(fk.DamageCaused, {
  anim_type = "offensive",
  can_trigger = function(self, event, target, player, data)
    return  target==player and player:hasSkill(pujqtoav.name)
    and data.card
    and table.contains(data.card.skillNames, pujqtoav.name) 
  end,
  on_cost = function(self, event, target, player, data)
    local room = player.room
    local suits = {"log_spade", "log_heart", "log_club", "log_diamond"}
    local choices = room:askToChoices(player, {
      choices = suits,
      min_num = 1,
      max_num = 1,
      skill_name = pujqtoav.name,
      prompt = "#pujqtoav-choice:"..data.to.id,
      cancelable = true,
    })
    if #choices > 0 then
      event:setCostData(self, {choice = choices})
      return true
    end
  end,
  on_use = function(self, event, target, player, data)
    player.room:setPlayerMark(data.to, "@pujqtoav", event:getCostData(self).choice)
  end,
})

pujqtoav:addEffect("prohibit", {
  prohibit_use = function(self, player, card)
    if player:getMark("@pujqtoav") ~= 0 and card then
      if table.contains(player:getMark("@pujqtoav"), card:getSuitString(true))  then
        return true
      end
      local subcards = card:isVirtual() and card.subcards or {card.id}  --isVirtual id==0
      for _, id in ipairs(subcards) do
        if table.contains(player:getTableMark("@pujqtoav"), Fk:getCardById(id):getColorString()) then
          return true
        end
      end
    end
  end,
  prohibit_response = function(self, player, card)
    if player:getMark("@pujqtoav") ~= 0 and card then
      if table.contains(player:getMark("@pujqtoav"), card:getSuitString(true))  then
        return true
      end
      local subcards = card:isVirtual() and card.subcards or {card.id}  --isVirtual id==0
      for _, id in ipairs(subcards) do
        if table.contains(player:getTableMark("@pujqtoav"), Fk:getCardById(id):getColorString()) then
          return true
        end
      end
    end
  end,
})


pujqtoav:addEffect(fk.TurnEnd, {
  is_delay_effect=true,
  can_refresh = function(self, player, card)
    return target==player and player:getMark("@pujqtoav") ~= 0 
  end,
  on_refresh = function(self, player, card)
    player.room:setPlayerMark(target, "@pujqtoav", 0)
  end,
})
return pujqtoav
